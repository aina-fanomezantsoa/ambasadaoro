# Copier ce fichier en ".env" puis remplir. Ne jamais publier ".env".

# Base Neon : console.neon.tech > projet > Connect (chaîne "pooled")
DATABASE_URL=

# Signature des sessions admin : 32 caractères aléatoires au moins
SESSION_SECRET=
# Seul compte admin. Le mot de passe se crée avec : npm run admin:password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Photos (tâche T05) : console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alerte e-mail (tâche T10) : resend.com > API Keys
# Sans domaine vérifié, ADMIN_EMAIL doit être l'adresse du compte Resend.
RESEND_API_KEY=

# Numéros affichés aux acheteurs (tâches T10 et T13)
NEXT_PUBLIC_WHATSAPP_NUMBER=
MVOLA_NUMBER=
ORANGE_MONEY_NUMBER=
