# Copier ce fichier en ".env" puis remplir. Ne jamais publier ".env".

# Base Neon : console.neon.tech > projet > Connect (chaîne "pooled")
DATABASE_URL=

# Signature des sessions admin : 32 caractères aléatoires au moins
BETTER_AUTH_SECRET=
# Adresse du site
BETTER_AUTH_URL=http://localhost:3000
# Connexion admin : console.cloud.google.com > API et services > Identifiants > ID client OAuth
# URI de redirection : <adresse du site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seul compte Google autorisé dans l'admin
ADMIN_EMAIL=

# Photos (tâche T05) : console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alerte e-mail (tâche T10) : resend.com > API Keys
RESEND_API_KEY=

# Numéros affichés aux acheteurs (tâches T10 et T13)
NEXT_PUBLIC_WHATSAPP_NUMBER=
MVOLA_NUMBER=
ORANGE_MONEY_NUMBER=
